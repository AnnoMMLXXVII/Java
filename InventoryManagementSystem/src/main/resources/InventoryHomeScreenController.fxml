<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="InventoryHomeScreenContainer" maxHeight="504.0" maxWidth="949.0" minHeight="480.0" minWidth="1000.0" prefHeight="480.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <MenuBar fx:id="InventoryHomeScreenMainMenuBar" prefHeight="32.0" prefWidth="1000.0" AnchorPane.bottomAnchor="448.0">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem fx:id="menuExitItem" mnemonicParsing="false" onAction="#exitProgram" text="Exit" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <Label fx:id="InventoryHomeScreenMainHeaderLbl" layoutX="14.0" layoutY="32.0" prefHeight="61.0" prefWidth="762.0" style="-fx-border-color: Magenta; -fx-border-width: 1; -fx-label-padding: 4; -fx-border-radius: 20;" text="Inventory Management System" textAlignment="CENTER">
            <font>
                <Font name="Arial Black" size="30.0" />
            </font>
        </Label>
        <Button fx:id="InventoryHomeScreenExitBtn" layoutX="810.0" layoutY="41.0" mnemonicParsing="false" onMouseClicked="#exitProgramButton" prefHeight="42.0" prefWidth="151.0" text="Exit" textFill="RED">
         <font>
            <Font name="System Bold" size="19.0" />
         </font></Button>
        <AnchorPane id="outterPartsBoxMain" layoutX="14.0" layoutY="100.0" prefHeight="366.0" prefWidth="485.0" style="-fx-border-radius: 20; -fx-border-color: gray;">
            <children>
                <Label id="partsLabelMain" prefHeight="48.0" prefWidth="78.0" style="-fx-label-padding: 10;" text="Parts">
                    <font>
                        <Font name="System Bold Italic" size="18.0" />
                    </font>
                </Label>
                <TextField id="partsSearchFieldMain" fx:id="InventoryHomeScreenPartSearchInput" layoutX="10.0" layoutY="37.0" onMouseClicked="#clearText" prefHeight="31.0" prefWidth="310.0" promptText="Enter Part Id or Part Name" style="-fx-padding: 2; -fx-border-color: gray;">
               <font>
                  <Font size="15.0" />
               </font></TextField>
                <Button fx:id="InventoryHomeScreenAddPartBtn" layoutX="18.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#addPart" prefWidth="100.0" style="-fx-padding: 10;" text="Add">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <Button fx:id="InventoryHomeScreenModifyPartBtn" layoutX="178.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#modifyPart" prefWidth="100.0" style="-fx-padding: 10;" text="Modify">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <Button fx:id="InventoryHomeScreenDeleteBtn" layoutX="339.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#deletePart" prefWidth="100.0" style="-fx-padding: 10;" text="Delete" textFill="RED">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <TableView fx:id="InventoryHomeScreenPartsTable" layoutX="10.0" layoutY="78.0" prefHeight="226.0" prefWidth="467.0">

                    <items>

                    </items>
                    <columns>
                        <TableColumn fx:id="InventoryHomeScreenPartIDColHeader" prefWidth="155.0" text="Part ID">
                            <cellValueFactory>
                                <PropertyValueFactory property="Id" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="InventoryHomeScreenPartNameColHeader" prefWidth="155.0" text="Part Name">
                            <cellValueFactory>
                                <PropertyValueFactory property="Name" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="InventoryHomeScreenPartCountColHeader" prefWidth="155.0" style="text-align: justify;" text="Inventory Count">
                            <cellValueFactory>
                                <PropertyValueFactory property="Stock" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <Button fx:id="InventoryHomeScreenPartSearchBtn" layoutX="330.0" layoutY="37.0" mnemonicParsing="false" onMouseClicked="#searchForPart" prefHeight="31.0" prefWidth="142.0" text="Search Part">
               <font>
                  <Font size="15.0" />
               </font></Button>
            </children>
        </AnchorPane>
        <AnchorPane id="outterPRoductsBoxMain" layoutX="505.0" layoutY="100.0" prefHeight="366.0" prefWidth="485.0" style="-fx-border-radius: 20; -fx-border-color: gray;">
            <children>
                <Label id="productsLabelMain" alignment="TOP_LEFT" style="-fx-label-padding: 10;" text="Products">
                    <font>
                        <Font name="System Bold Italic" size="18.0" />
                    </font>
                </Label>
                <TextField id="partsSearchFieldMain" fx:id="InventoryHomeScreenProductSearchInput" layoutX="10.0" layoutY="37.0" onMouseClicked="#clearText" prefHeight="31.0" prefWidth="310.0" promptText="Enter Product Id or Product Name" style="-fx-padding: 2; -fx-border-color: gray;">
               <font>
                  <Font size="15.0" />
               </font></TextField>
                <Button fx:id="InventoryHomeScreenProductDeleteBtn" layoutX="339.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#deleteProduct" prefWidth="100.0" style="-fx-padding: 10;" text="Delete" textFill="RED">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <Button fx:id="InventoryHomeScreenProductModifyBtn" layoutX="178.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#modifyProduct" prefHeight="42.0" prefWidth="100.0" style="-fx-padding: 10;" text="Modify">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <Button fx:id="InventoryHomeScreenAddProductBtn" layoutX="18.0" layoutY="313.0" mnemonicParsing="false" onMouseClicked="#addProduct" prefHeight="42.0" prefWidth="100.0" style="-fx-padding: 10;" text="Add">
               <font>
                  <Font size="15.0" />
               </font></Button>
                <TableView fx:id="InventoryHomeScreenProductsTable" layoutX="10.0" layoutY="78.0" prefHeight="226.0" prefWidth="467.0">
                    <columns>
                        <TableColumn fx:id="InventoryHomeScreenProductIDColHeader" prefWidth="155.0" text="Product ID">
                            <cellValueFactory>
                                <PropertyValueFactory property="ProductID" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="InventoryHomeScreenProductNameColHeader" prefWidth="155.0" text="Product Name">
                            <cellValueFactory>
                                <PropertyValueFactory property="Name" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="InventoryHomeScreenProductCountColHeader" prefWidth="155.0" style="text-align: justify;" text="Inventory Count">
                            <cellValueFactory>
                                <PropertyValueFactory property="InStock" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <Button fx:id="InventoryHomeScreenProductSearchBtn" layoutX="330.0" layoutY="37.0" mnemonicParsing="false" onMouseClicked="#searchForProduct" prefHeight="31.0" prefWidth="142.0" text="Search Product">
               <font>
                  <Font size="15.0" />
               </font></Button>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
