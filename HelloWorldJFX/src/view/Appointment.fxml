<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.SepiaTone?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="1200.0" style="-fx-background-color: #57A0D3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AppointmentController">
    <effect>
        <SepiaTone level="0.15" />
    </effect>
    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="75.0" prefWidth="1200.0" style="-fx-background-color: BLACK;" text="APPOINTMENTS" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        <TableView fx:id="appointmentsTableView" layoutY="125.0" onMouseClicked="#onTableViewAppointments" prefHeight="250.0" prefWidth="1200.0">
            <columns>
                <TableColumn fx:id="apptIDCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="103.0" text="Appointment_ID" />
                <TableColumn fx:id="titleCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="111.0" text="Title" />
                <TableColumn fx:id="descriptionCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="176.0" text="Description" />
                <TableColumn fx:id="locationCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="109.0" text="Location" />
                <TableColumn fx:id="contactCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="119.0" text="Contact" />
                <TableColumn fx:id="typeCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="103.0" text="Type" />
                <TableColumn fx:id="startCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="120.0" text="Start" />
                <TableColumn fx:id="endCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="120.0" text="End" />
                <TableColumn fx:id="customerIDCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="120.0" text="Customer_ID" />
                <TableColumn fx:id="userIDCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="120.0" text="User_ID" />
            </columns>
        </TableView>
      <Pane layoutX="506.0" layoutY="525.0" prefWidth="692.0">
         <children>
              <Button fx:id="updateBtnAppointment" layoutX="161.0" mnemonicParsing="false" onAction="#onUpdateAction" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: palegreen;" text="SAVE">
               <font>
                  <Font size="24.0" />
               </font></Button>
              <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDeleteBtn" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: lightcoral;" text="REMOVE">
               <font>
                  <Font size="24.0" />
               </font></Button>
              <Button fx:id="addBtn" layoutX="333.0" mnemonicParsing="false" onAction="#onAddBtn" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: aqua;" text="ADD">
               <font>
                  <Font size="24.0" />
               </font></Button>
              <Button fx:id="cancelBtn" layoutX="501.0" mnemonicParsing="false" onAction="#onCancelBtn" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" text="Cancel">
               <font>
                  <Font size="24.0" />
               </font></Button>
         </children>
      </Pane>
      <Pane fx:id="appointmentsFormPane" layoutX="10.0" layoutY="399.0" prefHeight="110.0" prefWidth="1179.0">
         <children>
              <TextField fx:id="titleOfAppt" layoutX="165.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
              <TextField fx:id="description" layoutX="325.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
              <TextField fx:id="location" layoutX="492.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
              <Label prefHeight="20.0" prefWidth="150.0" text="Customer">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="165.0" prefHeight="20.0" prefWidth="150.0" text="Title of Appointment">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="325.0" prefHeight="20.0" prefWidth="150.0" text="Description">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="492.0" prefHeight="20.0" prefWidth="150.0" text="Location">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="653.0" prefHeight="20.0" prefWidth="150.0" text="Conctact">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="330.0" layoutY="56.0" prefHeight="20.0" prefWidth="150.0" text="Type of Appointment">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="825.0" prefHeight="20.0" prefWidth="150.0" text="Start Date">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <ComboBox fx:id="customerSelect" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" promptText="Choose Customer" style="-fx-background-color: #EBECF0;" />
              <Label layoutX="993.0" prefHeight="20.0" prefWidth="150.0" text="End Date">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <DatePicker fx:id="endDatePickerAppointment" layoutX="993.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" promptText="Select date" style="-fx-background-color: #EBECF0;" />
              <Label layoutX="1.0" layoutY="56.0" prefHeight="20.0" prefWidth="150.0" text="Start Time">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <Label layoutX="166.0" layoutY="56.0" prefHeight="20.0" prefWidth="150.0" text="End Time">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
              <TextField fx:id="apptID" editable="false" layoutX="497.0" layoutY="85.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
              <Label layoutX="497.0" layoutY="56.0" prefHeight="20.0" prefWidth="150.0" text="Appointment_ID">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
            <ComboBox fx:id="contactSelect" layoutX="653.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" promptText="Select Contact" style="-fx-background-color: #EBECF0;" />
            <DatePicker fx:id="startDatePickerAppointment" layoutX="825.0" layoutY="30.0" prefHeight="20.0" prefWidth="150.0" promptText="Select Start Date" style="-fx-background-color: #EBECF0;" />
            <TextField fx:id="startTimeInputAppointment" layoutX="-2.0" layoutY="84.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
            <TextField fx:id="endTimeInputAppointment" layoutX="165.0" layoutY="84.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
            <TextField fx:id="typeInputAppointment" layoutX="325.0" layoutY="85.0" prefHeight="20.0" prefWidth="150.0" style="-fx-background-color: #EBECF0;" />
         </children>
      </Pane>
        <BorderPane layoutY="376.0" opacity="0.5" prefHeight="20.0" prefWidth="1200.0" style="-fx-background-color: #000000;" />
        <HBox alignment="CENTER" layoutY="75.0" prefHeight="50.0" prefWidth="1200.0">
            <children>
                <RadioButton fx:id="weekRadioBtn" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onWeekRadioBtn" prefHeight="40.0" prefWidth="225.0" text="This &amp; Next week">
                    <padding>
                        <Insets right="30.0" />
                    </padding>
                    <toggleGroup>
                        <ToggleGroup fx:id="group" />
                    </toggleGroup>
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </RadioButton>
                <RadioButton fx:id="monthRadioBtn" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onMonthRadioBtn" prefHeight="40.0" prefWidth="225.0" text="Next month" toggleGroup="$group">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </RadioButton>
                <RadioButton fx:id="allRadioBtn" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onAllRadioBtn" prefHeight="40.0" prefWidth="225.0" text="Show all" toggleGroup="$group">
                    <HBox.margin>
                        <Insets left="30.0" />
                    </HBox.margin>
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </RadioButton>
            </children>
        </HBox>
    </children>
</AnchorPane>
